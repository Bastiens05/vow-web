# URL du projet Supabase.
# Local (supabase start) : http://127.0.0.1:54321
# Cloud préparé : https://hwrcmkvfuytviixqibzo.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publishable (anon). Dashboard → Project Settings → API Keys.
# L'ancien nom NEXT_PUBLIC_SUPABASE_ANON_KEY est encore accepté.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paiement en ligne (acomptes et abonnement prestataire). Les deux doivent être
# présents, sinon aucun appel Stripe n'est fait et « S'abonner » reste fermé.
# NEXT_PUBLIC_STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=

# Clé service_role. Réservée au script de seed (npm run seed).
# Ne jamais la préfixer par NEXT_PUBLIC_ et ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisée pour les liens d'invitation et les redirections auth.
# Local : http://127.0.0.1:3000
# Production : l'URL Vercel, sans slash final.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Code à 6 chiffres dans l'e-mail. Laisser vide : le modèle par défaut de Supabase
# ne contient que {{ .ConfirmationURL }}. N'activer que si le modèle inclut {{ .Token }}.
# Avec le SMTP Resend documenté dans le README, le modèle peut contenir {{ .Token }}.
# NEXT_PUBLIC_AUTH_OTP_CODE=true

# E-mails produit (invitations, rappels, devis, factures, signature, jour J,
# relais, plan pluie, météo). Sans RESEND_API_KEY, rien n'est envoyé.
# Météo Open-Meteo (gratuit, usage non commercial). Laisser WEATHER_ALERTS_ENABLED
# vide en production tant qu'un fournisseur ou un plan commercial n'est pas en place.
# WEATHER_ALERTS_ENABLED=true
# WEATHER_PROVIDER=open-meteo
# RESEND_API_KEY=
# EMAIL_FROM="VOW <bonjour@example.com>"

# Alertes push (optionnel). Sans ces clés, VOW reste sur le fil dans l'application.
# Générer une paire : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:bonjour@example.com
